+// Copy one local block (diag or off-diag) into a target block that may differ from the source
+// in BOTH precision and storage format. A single Ginkgo copy_from cannot do a combined
+// cross-precision + cross-format conversion (e.g. a Coo<double> off-diagonal, as assembled by an
+// application, into the default Csr<float> off-diagonal of a reduced-precision copy created by
+// Pgm/Multigrid): copy_from resolves to as<ConvertibleTo<Csr<float>>>(Coo<double>), which throws
+// NotSupported. So convert the PRECISION first while preserving the source format (device-side),
+// then copy_from into the target -- a same-precision format change, which IS supported. Csr/Coo
+// (the formats distributed::Matrix actually uses) take the device path; anything else routes
+// through format- and precision-agnostic matrix_data.
+template <typename SourceValueType, typename TargetValueType, typename IndexType>
+void convert_local_block(const LinOp* source, LinOp* target)
+{
+    auto exec = source->get_executor();
+    if (auto coo =
+            dynamic_cast<const gko::matrix::Coo<SourceValueType, IndexType>*>(
+                source)) {
+        auto lower = gko::matrix::Coo<TargetValueType, IndexType>::create(exec);
+        coo->convert_to(lower.get());
+        target->copy_from(lower.get());
+    } else if (auto csr = dynamic_cast<
+                   const gko::matrix::Csr<SourceValueType, IndexType>*>(
+                   source)) {
+        auto lower = gko::matrix::Csr<TargetValueType, IndexType>::create(exec);
+        csr->convert_to(lower.get());
+        target->copy_from(lower.get());
+    } else {
+        matrix_data<SourceValueType, IndexType> src_data;
+        as<const WritableToMatrixData<SourceValueType, IndexType>>(source)
+            ->write(src_data);
+        matrix_data<TargetValueType, IndexType> dst_data{src_data.size};
+        dst_data.nonzeros.reserve(src_data.nonzeros.size());
+        for (const auto& e : src_data.nonzeros) {
+            dst_data.nonzeros.emplace_back(
+                e.row, e.column, static_cast<TargetValueType>(e.value));
+        }
+        as<ReadableFromMatrixData<TargetValueType, IndexType>>(target)->read(
+            dst_data);
+    }
+}
