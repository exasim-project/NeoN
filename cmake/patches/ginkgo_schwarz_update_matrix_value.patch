+template <typename ValueType, typename LocalIndexType, typename GlobalIndexType>
+std::shared_ptr<const LinOp>
+Schwarz<ValueType, LocalIndexType, GlobalIndexType>::extract_local_matrix(
+    std::shared_ptr<const LinOp> system_matrix) const
+{
+    using Mtx = Matrix<ValueType, LocalIndexType, GlobalIndexType>;
+    // Reduced-precision preconditioner support. The distributed system matrix is
+    // assembled once in fp64, but the Schwarz preconditioner (and the local solver
+    // hierarchy it wraps) may be requested in a lower precision via the config
+    // node's "value_type" -- absent => double, the default. When this Schwarz is a
+    // float preconditioner fed the fp64 distributed::Matrix, convert the matrix down
+    // to float here so the whole local solve runs in float. The dynamic_cast fast
+    // path keeps the same-precision (default double) case allocation-free; this is
+    // the single choke point shared by generate() and update_matrix_value(), so the
+    // cached-refresh path is converted identically.
+    std::shared_ptr<const Mtx> dist_mat;
+    if constexpr (std::is_same<ValueType, float>::value) {
+        dist_mat = std::dynamic_pointer_cast<const Mtx>(system_matrix);
+        if (!dist_mat) {
+            using HighMtx = Matrix<double, LocalIndexType, GlobalIndexType>;
+            auto high_mat = as<HighMtx>(system_matrix);
+            // Match the source block formats (Csr diagonal + Coo off-diagonal, as
+            // assembled by NeoN's createGkoMtxDist) so convert_to() performs a
+            // precision-only conversion of each block. A default-format target
+            // would force an unsupported cross-format + cross-precision
+            // Coo<double> -> Csr<float> copy inside Matrix::convert_to().
+            auto converted = Mtx::create(
+                this->get_executor(), high_mat->get_communicator(),
+                gko::with_matrix_type<matrix::Csr>(),
+                gko::with_matrix_type<matrix::Coo>());
+            high_mat->convert_to(converted.get());
+            dist_mat = gko::share(std::move(converted));
+        }
+    } else {
+        dist_mat = as<Mtx>(system_matrix);
+    }
+    std::shared_ptr<const LinOp> diag_matrix = dist_mat->get_diag_matrix();
+
+    if (!parameters_.l1_smoother) {
+        return diag_matrix;
+    }
+
+    auto exec = this->get_executor();
+
+    using Csr = matrix::Csr<ValueType, LocalIndexType>;
+    auto diag_matrix_copy = share(Csr::create(exec));
+    as<ConvertibleTo<Csr>>(diag_matrix)->convert_to(diag_matrix_copy);
+
+    auto off_diag_matrix =
+        copy_and_convert_to<Csr>(exec, dist_mat->get_off_diag_matrix());
+
+    array<ValueType> l1_diag_arr{exec, diag_matrix->get_size()[0]};
+
+    exec->run(make_row_wise_absolute_sum(off_diag_matrix.get(), l1_diag_arr));
+
+    // compute diag_matrix_copy <- diag(l1) + diag_matrix_copy
+    auto l1_diag = matrix::Diagonal<ValueType>::create(
+        exec, diag_matrix->get_size()[0], std::move(l1_diag_arr));
+    auto l1_diag_csr = Csr::create(exec);
+    l1_diag->move_to(l1_diag_csr);
+    auto id = matrix::Identity<ValueType>::create(exec,
+                                                  diag_matrix->get_size()[0]);
+    auto one =
+        initialize<matrix::Dense<ValueType>>({::gko::one<ValueType>()}, exec);
+    l1_diag_csr->apply(one, id, one, diag_matrix_copy);
+
+    return diag_matrix_copy;
+}
