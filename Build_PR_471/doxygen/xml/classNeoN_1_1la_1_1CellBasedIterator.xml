<parameternamelist>
<parametername>mesh</parametername>
</parameternamelist>
<parameterdescription>
<para>The mesh providing owner/neighbour topology. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>sparsityPattern</parametername>
</parameternamelist>
<parameterdescription>
<para>Sparsity pattern of the linear system. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>faceToMatrixAddress</parametername>
</parameternamelist>
<parameterdescription>
<para>Mapping from faces to matrix row offsets. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
